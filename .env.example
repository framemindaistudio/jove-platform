# ─────────────────────────────────────────────────────────────────────────────
#  JOVE — environment variables
#  Copy to .env.local for local development. On Vercel: Project → Settings →
#  Environment Variables (add to Production + Preview).
# ─────────────────────────────────────────────────────────────────────────────

# ── Public website ───────────────────────────────────────────────────────────
# Defaults to https://www.jove.website in production; set it only if the address changes.
NEXT_PUBLIC_SITE_URL=https://www.jove.website
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# digits only with country code, e.g. 919876543210 (enables WhatsApp buttons)
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_LOCATION=India
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_YOUTUBE=
NEXT_PUBLIC_LINKEDIN=

# ── Analytics (Google Analytics 4, public site only) ────────────────────────
# Built in: the JOVE property, and visitors are asked before anything is sent.
# Another property:  NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX      No analytics:  NEXT_PUBLIC_GA_ID=off
# Measure without asking first (visitors can still opt out on /privacy):
# NEXT_PUBLIC_ANALYTICS_CONSENT=always

# ── HQ login ─────────────────────────────────────────────────────────────────
# 32+ random characters. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HQ_SESSION_SECRET=

# JSON array of team accounts. Roles: founder | admin (can change everything) · ops | trainer | media (view and print only)
# · viewer (the shared interns login: view and print the teaching and delivery side only, no finance or contacts)
# Add or remove one person later with:  node scripts/hq-user.mjs add <username> "<Full Name>"
# Easiest: node scripts/make-hq-env.mjs  (writes a ready-to-import .env.vercel with hashed passwords)
# Password can be plain text or "sha256:<hash>"  →  node scripts/hash-password.mjs "your-password"
HQ_USERS=[{"username":"shiva","name":"Shivaprasad Reddy S S","role":"founder","password":"sha256:REPLACE"},{"username":"chinmay","name":"Chinmay R M","role":"founder","password":"sha256:REPLACE"}]

# ── HQ data store (a PRIVATE GitHub repo is the database) ───────────────────
# This code repo can be public. Company data lives in a SEPARATE PRIVATE repo
# (data/, OPERATIONS/, vault/). HQ refuses to save if GITHUB_REPO is public.
# Fine-grained personal access token with "Contents: Read and write" on the data repo only.
GITHUB_TOKEN=
# owner/private-data-repo, e.g. your-account/jove-hq-data
GITHUB_REPO=
GITHUB_BRANCH=main

# ── Prices (HQ → Money → Prices & Costs) ─────────────────────────────────────
# Every build reads the saved public prices from the data repository above and bakes them into the site.
# A Deploy Hook lets HQ start that build by itself when a price is saved:
# Vercel → project → Settings → Git → Deploy Hooks → create one for branch main → paste its address here.
VERCEL_DEPLOY_HOOK_URL=
